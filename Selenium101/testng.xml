<?xml version="1.0" encoding="UTF-8"?>

<suite name="Cross-Browser Selenium Tests" parallel="tests" thread-count="3">
    
    <!-- Test for Chrome -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" >
                      <methods>
                    <!-- Enable specific methods for Chrome -->
                    <include name="testSimpleFormDemo" enabled="true" priority="1"/>
                    <include name="testSliderDragAndDrop" enabled="true" priority="2"/> <!-- Disable this method for Chrome -->
                    <include name="testFormSubmission" enabled="true" priority="3"/>
                </methods>
                  </class>
        </classes>
    </test>

    <!-- Test for Firefox -->
    <test name="Firefox Tests" enabled= "true">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" >
                      <methods>
                    <!-- Enable specific methods for firefox -->
                    <include name="testSimpleFormDemo" enabled="true" priority="1"/>
                    <include name="testSliderDragAndDrop" enabled="true" priority="2"/> <!-- Disable this method for Chrome -->
                    <include name="testFormSubmission" enabled="true" priority="3"/>
                </methods>
                  </class>
        </classes>
    </test>

    <!-- Test for Edge -->
    <test name="Edge Tests" enabled= "false">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" >
                      <methods>
                    <!-- Enable specific methods for Edge -->
                    <include name="testSimpleFormDemo" enabled="true"/>
                    <include name="testSliderDragAndDrop" enabled="true"/> <!-- Disable this method for Chrome -->
                    <include name="testFormSubmission" enabled="true"/>
                </methods>
                  </class>
        </classes>
    </test>

</suite>

