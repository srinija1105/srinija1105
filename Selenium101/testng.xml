<?xml version="1.0" encoding="UTF-8"?>

<suite name="Cross-Browser Selenium Tests" parallel="tests" thread-count="3">
    
    <!-- Test for Chrome -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" />
        </classes>
    </test>

    <!-- Test for Firefox -->
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" />
        </classes>
    </test>

    <!-- Test for Edge -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="Seleniumpkg.Lambdatest" />
        </classes>
    </test>

</suite>

